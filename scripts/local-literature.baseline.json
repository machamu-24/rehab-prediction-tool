          "coefficient": -0.034,
          "hazardRatio": 0.966
        },
        {
          "ci95": [
            1.117,
            3.274
          ],
          "unit": "binary",
          "field": "sit_up_independent",
          "notes": "起き上がり介助不要で歩行自立が早まる",
          "pValue": 0.05,
          "direction": "positive",
          "fieldLabel": "起き上がり能力（介助なし=1, 介助あり=0）",
          "coefficient": 0.649,
          "hazardRatio": 1.912
        },
        {
          "ci95": [
            1.015,
            1.048
          ],
          "unit": "点",
          "field": "bbs_score",
          "notes": "BBS高いほど歩行自立が早まる",
          "pValue": 0.001,
          "direction": "positive",
          "fieldLabel": "Berg Balance Scale（BBS）",
          "coefficient": 0.031,
          "hazardRatio": 1.031

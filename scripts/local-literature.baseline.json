        {
          "ci95": [
            1.008,
            1.04
          ],
          "unit": "点",
          "field": "fim_motor_total",
          "notes": "FIM運動高いほど歩行自立が早まる",
          "pValue": 0.01,
          "direction": "positive",
          "fieldLabel": "FIM運動項目合計",
          "coefficient": 0.024,
          "hazardRatio": 1.024
        },
        {
          "ci95": [
            1.047,
            1.113
          ],
          "unit": "点",
          "field": "fim_cognitive_total",
          "notes": "FIM認知高いほど歩行自立が早まる",

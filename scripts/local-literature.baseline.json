  {
    "id": 30008,
    "name": "退院時FIM運動項目予測 重回帰式",
    "source": "安部千秋ら（2026）理学療法学 53(2):111–119",
    "sourceUrl": "https://www.jstage.jst.go.jp/article/rigaku/53/2/53_25-12662/_html/-char/ja",
    "ruleType": "regression",
    "outcomeId": 2,
    "applyConditions": [],
    "ruleDefinition": {
      "type": "regression",
      "formula": "fim_motor_discharge = fim_motor_total * 0.56 + fim_cognitive_total * 0.97 - age * 0.26 - days_onset_to_admission * 0.16 + 47.2",
      "intercept": 47.2,
      "outputMode": "continuous",
      "outputUnit": "点",
      "coefficients": [
        {
          "unit": "点",
          "field": "fim_motor_total",
          "fieldLabel": "入院時FIM運動項目合計",
          "coefficient": 0.56
